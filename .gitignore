# ANNÁVE TECH standard .gitignore (defense-in-depth against committed secrets).
# This is seeded once (never overwritten) alongside gh's own --gitignore template, if any; the
# two are complementary, not conflicting — gh's template covers language build artefacts, this
# one covers the secret/credential patterns no language template reliably includes.

# secrets / credentials
.env
*.env
*.token
*.secret
/secrets.*
.envrc
*.pem

# macOS
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# Binaries
/server
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Build output
/bin/
/dist/
/build/

# Coverage
coverage.out
*.coverprofile

# Go workspace
go.work
go.work.sum

# Environment files
.env.local

# Logs
*.log

# Temporary files
/tmp/
/temp/
